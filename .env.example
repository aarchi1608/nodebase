# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nodebase?schema=public"

# App & Better-Auth Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="change-this-to-a-secure-random-32-char-secret"

# Credential Encryption Key (Must be set, used to encrypt Gemini/OpenAI API keys in the database)
ENCRYPTION_KEY="your-32-character-encryption-key-here"

# (Optional) Social Logins - Better-Auth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# (Optional) Polar.sh Subscriptions
POLAR_ACCESS_TOKEN=""
POLAR_SUCCESS_URL="http://localhost:3000"

# (Optional) Inngest Configuration for Production
# In local development, the Inngest Dev Server (npm run inngest:dev) works out of the box without keys.
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
